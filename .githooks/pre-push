#!/bin/sh
#
# Pre-push gate for the Go submission service in cmd/jmail-http.
#
# Runs: go mod tidy (diff only), gofmt, go vet, golangci-lint, go test -race.
# The whole module is checked rather than only the pushed range: the package is
# small, and a stale file elsewhere in the tree is still a broken push.
#
# Installed with `mk install-githooks` (sets core.hooksPath to .githooks).
# Bypass a single push with `git push --no-verify`.
#
# Environment:
#   JMAIL_HOOK_STRICT=1   fail when golangci-lint is missing instead of skipping it.

set -u

if [ -t 1 ]; then
  bold=$(printf '\033[1m')
  red=$(printf '\033[31m')
  green=$(printf '\033[32m')
  yellow=$(printf '\033[33m')
  reset=$(printf '\033[0m')
else
  bold='' red='' green='' yellow='' reset=''
fi

repo=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$repo" || exit 0

# The hook is inert outside a Go checkout, e.g. when the tree is checked out
# without submodules or the module was moved.
if [ ! -f go.mod ]; then
  exit 0
fi

if ! command -v go >/dev/null 2>&1; then
  printf '%spre-push: go is not installed; cannot run the Go checks.%s\n' "$red" "$reset" >&2
  printf '          Install Go (see go.mod for the required version) or push with --no-verify.\n' >&2
  exit 1
fi

failures=0
failed_checks=''

fail() {
  failures=$((failures + 1))
  failed_checks="$failed_checks
  - $1"
  printf '    %sFAILED%s: %s\n' "$red" "$reset" "$1"
}

ok() {
  printf '    %sok%s: %s\n' "$green" "$reset" "$1"
}

section() {
  printf '\n%s==> %s%s\n' "$bold" "$1" "$reset"
}

# 1. Module metadata must be tidy. -diff is read-only, so a dirty go.mod/go.sum
#    is reported without being rewritten under the user.
section 'go mod tidy'
if tidy_output=$(go mod tidy -diff 2>&1); then
  ok 'go.mod and go.sum are tidy'
else
  printf '%s\n' "$tidy_output"
  fail 'go mod tidy (run `go mod tidy` and commit the result)'
fi

# 2. gofmt is the canonical formatter; goimports is not enforced because the
#    project does not use it everywhere.
section 'gofmt'
unformatted=$(gofmt -l . 2>&1)
if [ -z "$unformatted" ]; then
  ok 'all Go files are formatted'
else
  printf '%s\n' "$unformatted"
  fail 'gofmt (run `gofmt -w` on the files above)'
fi

# 3. Vet catches the class of bugs the compiler accepts.
section 'go vet'
if go vet ./...; then
  ok 'go vet'
else
  fail 'go vet'
fi

# 4. Lint. golangci-lint is not a module dependency, so a missing binary is a
#    warning unless the caller opted into strict mode.
section 'golangci-lint'
if command -v golangci-lint >/dev/null 2>&1; then
  if golangci-lint run --timeout 5m ./...; then
    ok 'golangci-lint'
  else
    fail 'golangci-lint'
  fi
elif [ "${JMAIL_HOOK_STRICT:-0}" = '1' ]; then
  fail 'golangci-lint is not installed (JMAIL_HOOK_STRICT=1)'
else
  printf '    %sSKIPPED%s: golangci-lint is not installed\n' "$yellow" "$reset"
  printf '             install it with: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest\n'
fi

# 5. Tests with the race detector, because the service is concurrent by design.
section 'go test -race'
if go test -race -count=1 ./...; then
  ok 'go test -race'
else
  fail 'go test -race'
fi

if [ "$failures" -ne 0 ]; then
  printf '\n%spre-push: %d check(s) failed:%s%s\n' "$red" "$failures" "$failed_checks" "$reset" >&2
  printf 'Fix the failures above, or push with --no-verify to bypass the hook.\n' >&2
  exit 1
fi

printf '\n%sAll pre-push checks passed.%s\n' "$green" "$reset"
exit 0
