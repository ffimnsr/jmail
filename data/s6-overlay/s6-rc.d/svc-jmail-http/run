#!/usr/bin/with-contenv bash

# The HTTP API is opt-in: a bearer token, the unnumbered Supabase hook secret,
# or any indexed one is the switch. s6 restarts a longrun whenever it exits and
# the bundle is static, so an unconfigured service parks here instead of turning
# into a restart loop.
if ! /usr/local/bin/jmail-http-enabled; then
  echo "jmail-http: disabled, set JMAIL_HTTP_TOKEN or a JMAIL_HTTP_SUPABASE_*_HOOK_SECRET to enable the HTTP API"
  exec tail -f /dev/null
fi

# svc-postfix only guarantees that Postfix was started; master.cf binds its
# listeners a moment later, and a request arriving before that fails with a 502.
# dockerize is already in the image for exactly this kind of wait.
dockerize -wait tcp://127.0.0.1:25 -timeout 60s

exec /usr/local/bin/jmail-http
