#!/usr/bin/with-contenv bash

set -e

addgroup postfix opendkim

mkdir -p /var/spool/postfix/pid \
  && chown -R 0:0 /var/spool/postfix/pid

mkdir -p /etc/sasl2

TEMPLATES_DIR=/etc/templates
dockerize \
  -template $TEMPLATES_DIR/postfix/aliases.tmpl:/etc/postfix/aliases \
  -template $TEMPLATES_DIR/postfix/canonical.tmpl:/etc/postfix/canonical \
  -template $TEMPLATES_DIR/postfix/generic.tmpl:/etc/postfix/generic \
  -template $TEMPLATES_DIR/postfix/main.cf.tmpl:/etc/postfix/main.cf \
  -template $TEMPLATES_DIR/postfix/master.cf.tmpl:/etc/postfix/master.cf \
  -template $TEMPLATES_DIR/opendkim/opendkim.conf.tmpl:/etc/opendkim/opendkim.conf \
  -template $TEMPLATES_DIR/opendkim/key.table.tmpl:/etc/opendkim/key.table \
  -template $TEMPLATES_DIR/opendkim/signing.table.tmpl:/etc/opendkim/signing.table \
  -template $TEMPLATES_DIR/opendkim/trusted.hosts.tmpl:/etc/opendkim/trusted.hosts \
  -template $TEMPLATES_DIR/sasl2/smtpd.conf.tmpl:/etc/sasl2/smtpd.conf \
  -template $TEMPLATES_DIR/syslog/syslog.conf.tmpl:/etc/syslog.conf \
  -template $TEMPLATES_DIR/scripts/test-mail.sh.tmpl:/usr/local/bin/test-mail.sh

# dockerize writes rendered files with default permissions, so make the helper runnable.
chmod 0755 /usr/local/bin/test-mail.sh

# Overrides sit on top of the rendered main.cf, so settings the templates do not
# expose can be changed without rebuilding the image. Each file holds one
# `parameter = value` per line. Names are validated first because postconf(1)
# exits 0 for an unknown parameter and only warns, which would otherwise leave a
# container running against a main.cf Postfix silently ignores.
shopt -s nullglob
for override_file in /etc/jmail/postfix.d/*.conf; do
  echo "Applying Postfix overrides from $override_file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    if [[ -z "$line" || "$line" == \#* ]]; then
      continue
    fi
    override_name="${line%%=*}"
    override_name="${override_name%"${override_name##*[![:space:]]}"}"
    if [[ "$override_name" == "$line" ]]; then
      echo "error: $override_file: expected 'parameter = value', got: $line" >&2
      exit 1
    fi
    override_error="$(postconf -h "$override_name" 2>&1 >/dev/null)"
    if [[ -n "$override_error" ]]; then
      echo "error: $override_file: $override_error" >&2
      exit 1
    fi
    postconf -e "$line"
  done <"$override_file"
done

echo "Creating temporary self-signed certificate for $JMAIL_ORIGIN"
echo "Copy everything between the dashed lines into your mail client to trust the certificate"
openssl req -x509 -noenc -sha384 -days 3650 -utf8 \
  -newkey ec:<(openssl ecparam -name secp384r1) \
  -keyout $TEMPLATES_DIR/postfix/ssl/server.key \
  -out $TEMPLATES_DIR/postfix/ssl/server.crt \
  -subj "/O=Jmail Self-Signed Server Cert/CN=$JMAIL_ORIGIN" \
  -addext "basicConstraints=critical,CA:FALSE" \
  -addext="extendedKeyUsage=critical,serverAuth" \
  -addext "keyUsage=critical,nonRepudiation,digitalSignature,keyEncipherment,keyAgreement" \
  -addext "subjectAltName=DNS:$JMAIL_ORIGIN"

cat $TEMPLATES_DIR/postfix/ssl/server.crt
echo "-----"

POSTFIX_SSL_DIR=/etc/postfix/ssl
# Testing for the files, not the directory: /etc/postfix/ssl is commonly a mounted
# volume, which exists but starts empty. Checking only for the directory would skip
# the copy and leave Postfix without a certificate, so STARTTLS would fail.
mkdir -p "$POSTFIX_SSL_DIR"
for ssl_file in server.crt server.key; do
  if [[ ! -f "$POSTFIX_SSL_DIR/$ssl_file" ]]; then
    cp "$TEMPLATES_DIR/postfix/ssl/$ssl_file" "$POSTFIX_SSL_DIR/$ssl_file"
  fi
done

POSTFIX_SSL_GENERATE_FILE="${POSTFIX_SSL_DIR}/.generate"
echo "Checking SSL regeneration trigger"
if [[ -f "${POSTFIX_SSL_GENERATE_FILE}" ]]; then
  cp -R /etc/templates/postfix/ssl/* $POSTFIX_SSL_DIR
  rm -f "${POSTFIX_SSL_GENERATE_FILE}"
fi

postmap /etc/postfix/canonical
postmap /etc/postfix/generic
newaliases

# TODO: Add support for Ed25519 dkim keys
OPENDKIM_KEYS_DIR=/etc/opendkim/keys/$JMAIL_ORIGIN
if [[ ! -d "${OPENDKIM_KEYS_DIR}" ]]; then
  echo "Creating DKIM keys for $JMAIL_ORIGIN"
  mkdir -p $OPENDKIM_KEYS_DIR
  opendkim-genkey -b 2048 -d $JMAIL_ORIGIN -D $OPENDKIM_KEYS_DIR -s sendonly
  chown -R 0:0 $OPENDKIM_KEYS_DIR/sendonly.private
fi

OPENDKIM_KEYS_GENERATE_FILE=/etc/opendkim/keys/$JMAIL_ORIGIN/.generate
echo "Checking DKIM regeneration trigger for $JMAIL_ORIGIN"
if [[ -f "${OPENDKIM_KEYS_GENERATE_FILE}" ]]; then
  echo "Re-generate DKIM keys for $JMAIL_ORIGIN"
  opendkim-genkey -b 2048 -d $JMAIL_ORIGIN -D $OPENDKIM_KEYS_DIR -s sendonly
  chown -R 0:0 $OPENDKIM_KEYS_DIR/sendonly.private
  rm -f "${OPENDKIM_KEYS_GENERATE_FILE}"
fi

cat $OPENDKIM_KEYS_DIR/sendonly.txt

echo "Setting up SASL password for jmail user"
echo "${JMAIL_SMTP_PASSWORD}" | saslpasswd2 -p -c -u "${JMAIL_ORIGIN}" "${JMAIL_SMTP_USER}"

# Fix permission errors
chown -R postfix:postfix /etc/sasl2
chmod 660 /etc/sasl2/sasldb2

# Hooks run last: the rendered configuration, certificate, DKIM key and SASL
# account all exist, and none of the supervised services have started yet.
for hook in /etc/jmail/init.d/*.sh; do
  if [[ ! -x "$hook" ]]; then
    continue
  fi
  echo "Running customization hook $hook"
  "$hook"
done
