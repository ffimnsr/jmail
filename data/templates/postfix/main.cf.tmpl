maillog_file = /dev/stdout
compatibility_level = 3.11
biff = no
append_dot_mydomain = no
allow_percent_hack = no

myhostname = {{ .Env.JMAIL_HOSTNAME }}
myorigin = {{ .Env.JMAIL_ORIGIN }}
mydestination = localhost.localdomain, localhost
mynetworks = {{ .Env.JMAIL_MYNETWORKS }}

# Incoming
smtpd_banner = $myhostname ESMTP
smtpd_delay_reject = yes
smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated reject
smtpd_recipient_restrictions = permit_mynetworks permit_sasl_authenticated reject
# An authenticated client may only use a From: address at a domain this image
# signs. OpenDKIM has no key for anything else, so a leaked SMTP credential
# should not be usable to send as an arbitrary domain. permit_mynetworks comes
# first because jmail-http submits over the loopback and has its own sender
# policy. The map is rendered at startup from JMAIL_ORIGIN and JMAIL_DOMAINS.
smtpd_sender_restrictions = permit_mynetworks, check_sender_access regexp:/etc/postfix/sender_access.regexp, reject
smtpd_tls_cert_file = /etc/postfix/ssl/server.crt
smtpd_tls_key_file = /etc/postfix/ssl/server.key
# Port 25 carries plaintext loopback submissions from jmail-http, so the TLS
# requirement lives on the submission service in master.cf instead.
smtpd_tls_security_level = may
smtpd_tls_session_cache_database = lmdb:${data_directory}/smtpd_scache
smtpd_tls_auth_only = yes
smtpd_tls_loglevel = 1

# SASL Auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname

# Allow broken clients to connect
broken_sasl_auth_clients = yes

# Outgoing
# smtp_generic_maps = lmdb:/etc/postfix/generic
smtp_tls_CApath = /etc/ssl/certs
smtp_tls_security_level = encrypt
smtp_tls_session_cache_database = lmdb:${data_directory}/smtp_scache
smtp_tls_loglevel = 1

# Postscreen
postscreen_access_list = permit_mynetworks
postscreen_denylist_action = drop
postscreen_greet_action = enforce

# Milters
milter_default_action = accept
milter_protocol = 6
smtpd_milters = inet:127.0.0.1:8892
non_smtpd_milters = $smtpd_milters

alias_maps = lmdb:/etc/postfix/aliases
alias_database = lmdb:/etc/postfix/aliases
canonical_maps = lmdb:/etc/postfix/canonical
relayhost =
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = ipv4
readme_directory = no

disable_vrfy_command = yes
